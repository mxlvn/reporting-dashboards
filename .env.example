# ── App Auth ──────────────────────────────────────────────────────────────────
# Credentials you use to log into the dashboard
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random string used to sign sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-random-32-char-string

# ── URLs (change for production) ──────────────────────────────────────────────
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# ── Google Ads + GA4 ─────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:3001/api/oauth/google/callback as a redirect URI
# 4. Enable: Google Ads API, Google Analytics Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Meta Ads ──────────────────────────────────────────────────────────────────
# 1. Go to https://developers.facebook.com/ → My Apps → Create App
# 2. Add Facebook Login product, set redirect URI to:
#    http://localhost:3001/api/oauth/meta/callback
# 3. Add permissions: ads_read, ads_management
META_APP_ID=
META_APP_SECRET=

# ── LinkedIn Ads ──────────────────────────────────────────────────────────────
# 1. Go to https://www.linkedin.com/developers/apps → Create App
# 2. Under Auth, add redirect URL: http://localhost:3001/api/oauth/linkedin/callback
# 3. Request access to: Marketing Developer Platform
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── X (Twitter) Ads ───────────────────────────────────────────────────────────
# 1. Go to https://developer.twitter.com/en/portal/dashboard → Create Project & App
# 2. Enable OAuth 2.0, set callback URL: http://localhost:3001/api/oauth/x/callback
# 3. Request Ads API access (separate approval required)
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── TikTok Ads ────────────────────────────────────────────────────────────────
# 1. Go to https://business-api.tiktok.com/portal/ → My Apps → Create App
# 2. Add redirect URI: http://localhost:3001/api/oauth/tiktok/callback
# 3. Add scopes: user.info.basic, ad.read
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
