# ── App login ─────────────────────────────────────────────────────────────────
# Credentials you use to log into the dashboard
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random string for signing sessions (generate: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-random-32-char-string

# ── Upload API key (for automation) ───────────────────────────────────────────
# Set this to any secret string. Scripts, Zapier, or Make use this key to
# upload CSV/Excel exports without needing a browser login.
# Generate one: openssl rand -hex 24
UPLOAD_API_KEY=replace-with-a-secret-key

# ── URLs (change for production deployment) ────────────────────────────────────
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
